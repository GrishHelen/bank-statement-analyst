# Локальные настройки. Ключи заполняются только в .env.
# Провайдер модели: gigachat или openai (любой OpenAI-совместимый API).
LLM_PROVIDER=gigachat
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro
GIGACHAT_BASE_URL=https://api.giga.chat/v1/
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_TIMEOUT=30
GIGACHAT_MAX_TOKENS=1024
GIGACHAT_TEMPERATURE=0.3
# Дополнительный PEM-сертификат; путь относительно .env.
GIGACHAT_CA_BUNDLE_FILE=
APP_MAX_HISTORY_TURNS=5
APP_MAX_INPUT_CHARS=4000
# Лимит обращений к модели на один вопрос (шагов агента), от 1 до 10.
APP_MAX_AGENT_STEPS=5
# Для LLM_PROVIDER=openai: адрес, ключ и модель OpenAI-совместимого API.
# Примеры: https://api.z.ai/api/paas/v4/ + glm-4.5-flash; http://localhost:11434/v1 + qwen3:8b (Ollama).
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
